# Используем стабильную версию Node.js
FROM node:20-alpine

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем файлы манифестов для установки зависимостей
COPY package.json package-lock.json* ./

# Устанавливаем зависимости
RUN npm install

# Копируем все остальные файлы проекта
COPY . .

# Открываем порт, на котором работает Vite (по умолчанию 5173)
EXPOSE 5173

# Запускаем Vite в режиме разработки с пробросом на все интерфейсы
# Флаг --host нужен, чтобы Docker мог «увидеть» сервер внутри контейнера
CMD ["npm", "run", "dev", "--", "--host"]